{
  "name": "astropolish",
  "productName": "AstroPolish",
  "version": "3.2.0",
  "description": "Maak astrofoto's van de Dwarf 3 (en andere smart-telescopen) met \u00e9\u00e9n klik mooi, met alle tools van de grote programma's.",
  "main": "electron/main.js",
  "author": "Jonathan van Zijverden",
  "license": "MIT",
  "homepage": "https://github.com/Jona2511/astropolish",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "lint": "node test/lint.js",
    "test": "node test/lint.js && node test/formats-test.js && node test/algorithms-test.js && node test/project-test.js && node test/electron-security-test.js && node test/ops-test.js && node test/stack-test.js",
    "test:ui": "python3 test/ui-test.py",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.jona2511.astropolish",
    "productName": "AstroPolish",
    "files": [
      "electron/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AstroPolish",
      "artifactName": "AstroPolish-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "AstroPolish-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "AstroPolish-${version}-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "AstroPolish ${version}"
    }
  }
}
