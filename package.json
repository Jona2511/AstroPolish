{
  "name": "astropolish",
  "productName": "AstroPolish",
  "version": "1.0.0",
  "description": "Maak astrofoto's van de Dwarf 3 (en andere smart-telescopen) met één klik mooi.",
  "main": "electron/main.js",
  "author": "Jonathan van Zijverden",
  "license": "MIT",
  "homepage": "https://github.com/Jona2511/astropolish",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "test": "node test/engine-test.js /tmp/astropolish-test"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.jona2511.astropolish",
    "productName": "AstroPolish",
    "artifactName": "AstroPolish-${version}-${arch}-${target}.${ext}",
    "files": ["electron/**", "app/**", "build/icon.png", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AstroPolish"
    },
    "portable": { "artifactName": "AstroPolish-${version}-portable.exe" }
  }
}
